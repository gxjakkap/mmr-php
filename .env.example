APP_URL=http://localhost:8000
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=memorii
DB_USER=memorii
DB_PASS=change-me

# log = write emails to storage/logs/mail.log (development only — nobody receives them)
# smtp = send through an SMTP server (recommended for production) · mail = PHP mail() via the host's sendmail
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set true when served over HTTPS behind a proxy that hides $_SERVER['HTTPS']
SESSION_SECURE=false
SESSION_IDLE_SECONDS=28800
# Optional: absolute path for uploads (default storage/uploads — keep it outside the web root)
# UPLOAD_DIR=/var/lib/memorii/uploads

# Shown on /privacy, /terms and /contact. Fill these in before going public.
OPERATOR_NAME=
CONTACT_EMAIL=
CONTACT_LINE=
CONTACT_PHONE=
